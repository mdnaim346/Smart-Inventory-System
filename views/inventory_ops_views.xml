<odoo>
    <!-- Restock suggestions inbox -->
    <record id="view_suggestion_list" model="ir.ui.view">
        <field name="name">smart.inventory.suggestion.list</field>
        <field name="model">smart.inventory.suggestion</field>
        <field name="arch" type="xml">
            <list create="0" editable="bottom" decoration-muted="state != 'new'"
                  decoration-danger="state == 'new' and risk_level == 'high'">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            groups="smart_inventory.group_smart_inventory_manager"/>
                    <button name="action_reject" type="object" string="Reject"
                            groups="smart_inventory.group_smart_inventory_manager"/>
                </header>
                <field name="product_id" readonly="1"/>
                <field name="warehouse_id" readonly="1" optional="show"/>
                <field name="risk_level" widget="badge" decoration-danger="risk_level == 'high'"
                       decoration-warning="risk_level == 'medium'" decoration-success="risk_level == 'low'"/>
                <field name="vendor_id" readonly="state != 'new'" options="{'no_create': True}"/>
                <field name="suggested_qty" optional="show"/>
                <field name="quantity" readonly="state != 'new'"/>
                <field name="uom_id" optional="hide"/>
                <field name="unit_price" readonly="state != 'new'" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount" sum="Total"/>
                <field name="reason" optional="show"/>
                <field name="over_budget" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'new'"
                       decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"/>
                <field name="purchase_order_id" optional="show"/>
                <field name="reject_reason" optional="hide"/>
                <button name="action_approve" type="object" string="Approve" icon="fa-check"
                        invisible="state != 'new'" groups="smart_inventory.group_smart_inventory_manager"/>
                <button name="action_reject" type="object" string="Reject" icon="fa-times"
                        invisible="state != 'new'" groups="smart_inventory.group_smart_inventory_manager"/>
            </list>
        </field>
    </record>

    <record id="view_suggestion_form" model="ir.ui.view">
        <field name="name">smart.inventory.suggestion.form</field>
        <field name="model">smart.inventory.suggestion</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state != 'new'" groups="smart_inventory.group_smart_inventory_manager"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'new'" groups="smart_inventory.group_smart_inventory_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert" invisible="not reason">
                        <field name="reason" nolabel="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="product_id" readonly="1"/>
                            <field name="warehouse_id" readonly="1"/>
                            <field name="vendor_id" readonly="state != 'new'"/>
                            <field name="risk_level"/>
                        </group>
                        <group>
                            <field name="suggested_qty"/>
                            <field name="quantity" readonly="state != 'new'"/>
                            <field name="unit_price" readonly="state != 'new'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount"/>
                            <field name="over_budget"/>
                        </group>
                    </group>
                    <group invisible="state == 'new'">
                        <field name="decided_by_id"/>
                        <field name="decided_date"/>
                        <field name="purchase_order_id"/>
                        <field name="reject_reason" invisible="state != 'rejected'"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_suggestion_search" model="ir.ui.view">
        <field name="name">smart.inventory.suggestion.search</field>
        <field name="model">smart.inventory.suggestion</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="vendor_id"/>
                <field name="warehouse_id"/>
                <filter string="To Review" name="to_review" domain="[('state', '=', 'new')]"/>
                <filter string="High Risk" name="high_risk" domain="[('risk_level', '=', 'high')]"/>
                <filter string="Over Budget" name="over_budget" domain="[('over_budget', '=', True)]"/>
                <group>
                    <filter string="Vendor" name="group_vendor" context="{'group_by': 'vendor_id'}"/>
                    <filter string="Warehouse" name="group_warehouse" context="{'group_by': 'warehouse_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_suggestions" model="ir.actions.act_window">
        <field name="name">Restock Suggestions</field>
        <field name="res_model">smart.inventory.suggestion</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_review': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No restock suggestions to review</p>
            <p>Turn on <i>Review Suggestions Before Ordering</i> in Settings, or set a weekly budget:
               restock needs then wait here for a manager instead of going straight to purchase orders.</p>
        </field>
    </record>

    <record id="view_suggestion_reject_wizard_form" model="ir.ui.view">
        <field name="name">smart.inventory.suggestion.reject.wizard.form</field>
        <field name="model">smart.inventory.suggestion.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Suggestion">
                <field name="suggestion_ids" invisible="1"/>
                <p class="text-muted">The same product and warehouse will not be suggested again for 7 days.</p>
                <group>
                    <field name="reason" placeholder="Why is this restock not needed?"/>
                </group>
                <footer>
                    <button name="action_reject" type="object" string="Reject" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Seasons and promotions -->
    <record id="view_demand_event_list" model="ir.ui.view">
        <field name="name">smart.inventory.demand.event.list</field>
        <field name="model">smart.inventory.demand.event</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="factor"/>
                <field name="product_tmpl_ids" widget="many2many_tags" optional="show"/>
                <field name="categ_ids" widget="many2many_tags" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_demand_event_form" model="ir.ui.view">
        <field name="name">smart.inventory.demand.event.form</field>
        <field name="model">smart.inventory.demand.event</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Eid ul-Fitr"/></h1></div>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="factor"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="product_tmpl_ids" widget="many2many_tags"/>
                            <field name="categ_ids" widget="many2many_tags"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        Forecasts multiply demand on these days by the factor. Sales on the days of past
                        events are divided by it, so an earlier festival does not inflate normal days.
                        No products or categories: the event applies to all products.
                    </p>
                    <field name="note" placeholder="Notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_demand_events" model="ir.actions.act_window">
        <field name="name">Seasons and Promotions</field>
        <field name="res_model">smart.inventory.demand.event</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Vendor scorecard -->
    <record id="view_vendor_score_list" model="ir.ui.view">
        <field name="name">smart.inventory.vendor.score.list</field>
        <field name="model">smart.inventory.vendor.score</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <header>
                    <button name="action_refresh" type="object" string="Refresh" display="always"
                            groups="smart_inventory.group_smart_inventory_manager"/>
                </header>
                <field name="partner_id"/>
                <field name="score" widget="progressbar"/>
                <field name="on_time_rate"/>
                <field name="avg_delay_days"/>
                <field name="fill_rate"/>
                <field name="price_change_pct" decoration-danger="price_change_pct &gt; 5"
                       decoration-success="price_change_pct &lt; 0"/>
                <field name="order_count"/>
                <field name="receipt_count" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="last_update" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_vendor_scores" model="ir.actions.act_window">
        <field name="name">Vendor Scorecard</field>
        <field name="res_model">smart.inventory.vendor.score</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No vendor scores yet</p>
            <p>Scores are computed weekly from the last 180 days of confirmed purchase orders and receipts.
               Press Refresh to compute them now.</p>
        </field>
    </record>

    <!-- Counting: reasons, cycle count, adjustment report -->
    <record id="view_adjustment_reason_list" model="ir.ui.view">
        <field name="name">smart.inventory.adjustment.reason.list</field>
        <field name="model">smart.inventory.adjustment.reason</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_adjustment_reasons" model="ir.actions.act_window">
        <field name="name">Adjustment Reasons</field>
        <field name="res_model">smart.inventory.adjustment.reason</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <record id="view_stock_quant_inventory_smart" model="ir.ui.view">
        <field name="name">stock.quant.inventory.smart.inventory</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">
            <field name="product_categ_id" position="after">
                <field name="si_abc_class" optional="show"/>
            </field>
            <field name="inventory_diff_quantity" position="after">
                <field name="si_reason_id" optional="show" options="{'no_create': True}"
                       invisible="not inventory_quantity_set"/>
            </field>
        </field>
    </record>

    <record id="view_stock_quant_search_smart" model="ir.ui.view">
        <field name="name">stock.quant.search.smart.inventory</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.quant_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="product_id" string="Barcode" filter_domain="[('product_id.barcode', '=', self)]"/>
                <group>
                    <filter string="ABC Class" name="groupby_si_abc" context="{'group_by': 'si_abc_class'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_cycle_count" model="ir.actions.server">
        <field name="name">Cycle Count</field>
        <field name="model_id" ref="stock.model_stock_quant"/>
        <field name="state">code</field>
        <field name="code">action = model.action_si_cycle_count()</field>
    </record>

    <record id="view_adjustment_move_list" model="ir.ui.view">
        <field name="name">stock.move.adjustment.smart.inventory.list</field>
        <field name="model">stock.move</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="date"/>
                <field name="product_id"/>
                <field name="location_id" optional="hide"/>
                <field name="location_dest_id" optional="hide"/>
                <field name="si_reason_id"/>
                <field name="si_adjust_qty" sum="Total"/>
                <field name="si_adjust_value" sum="Total"/>
                <field name="inventory_name" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_adjustment_move_pivot" model="ir.ui.view">
        <field name="name">stock.move.adjustment.smart.inventory.pivot</field>
        <field name="model">stock.move</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="si_reason_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="si_adjust_value" type="measure"/>
                <field name="si_adjust_qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_adjustment_report" model="ir.actions.act_window">
        <field name="name">Stock Adjustments by Reason</field>
        <field name="res_model">stock.move</field>
        <field name="view_mode">pivot,list</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_adjustment_move_pivot')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_adjustment_move_list')})]"/>
        <field name="domain">[('is_inventory', '=', True), ('state', '=', 'done')]</field>
    </record>

    <!-- Lost sales -->
    <record id="view_stockout_list" model="ir.ui.view">
        <field name="name">smart.inventory.stockout.list</field>
        <field name="model">smart.inventory.stockout</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="date"/>
                <field name="product_tmpl_id"/>
                <field name="lost_qty" sum="Total"/>
                <field name="lost_value" sum="Total"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_stockout_pivot" model="ir.ui.view">
        <field name="name">smart.inventory.stockout.pivot</field>
        <field name="model">smart.inventory.stockout</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="product_tmpl_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="lost_value" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_stockouts" model="ir.actions.act_window">
        <field name="name">Lost Sales (Stockouts)</field>
        <field name="res_model">smart.inventory.stockout</field>
        <field name="view_mode">pivot,list</field>
    </record>

    <!-- Forecast accuracy -->
    <record id="view_forecast_graph" model="ir.ui.view">
        <field name="name">smart.inventory.forecast.graph</field>
        <field name="model">smart.inventory.forecast</field>
        <field name="arch" type="xml">
            <graph type="bar" order="desc">
                <field name="product_tmpl_id"/>
                <field name="abs_pct_error" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_forecast_accuracy" model="ir.actions.act_window">
        <field name="name">Forecast Accuracy</field>
        <field name="res_model">smart.inventory.forecast</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="domain">[('is_closed', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No finished forecasts yet</p>
            <p>A forecast is compared with real sales once its window (7 days by default) has passed.
               Lower error is better.</p>
        </field>
    </record>

    <!-- Overstock and dead stock actions -->
    <record id="action_overstock" model="ir.actions.act_window">
        <field name="name">Overstock</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_product_list_smart"/>
        <field name="domain">[('is_storable', '=', True)]</field>
        <field name="context">{'search_default_si_overstock': 1}</field>
    </record>

    <record id="view_dead_stock_wizard_form" model="ir.ui.view">
        <field name="name">smart.inventory.dead.stock.wizard.form</field>
        <field name="model">smart.inventory.dead.stock.wizard</field>
        <field name="arch" type="xml">
            <form string="Dead Stock Action">
                <group>
                    <field name="product_tmpl_ids" widget="many2many_tags"/>
                    <field name="action" widget="radio"/>
                </group>
                <group invisible="action != 'discount'">
                    <field name="pricelist_id" required="action == 'discount'"/>
                    <field name="discount"/>
                </group>
                <group invisible="action == 'discount'">
                    <field name="warehouse_id" required="action != 'discount'"/>
                    <field name="dest_warehouse_id" invisible="action != 'transfer'" required="action == 'transfer'"/>
                    <field name="vendor_id" invisible="action != 'return'" required="action == 'return'"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dead_stock_wizard" model="ir.actions.act_window">
        <field name="name">Clear Dead Stock</field>
        <field name="res_model">smart.inventory.dead.stock.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[(4, ref('smart_inventory.group_smart_inventory_manager'))]"/>
    </record>
</odoo>
