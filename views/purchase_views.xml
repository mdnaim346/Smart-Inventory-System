<odoo>
    <record id="purchase_order_form_smart" model="ir.ui.view">
        <field name="name">purchase.order.form.smart.inventory</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_si_approve" type="object" string="Approve Restock" class="oe_highlight"
                        invisible="si_approval_state != 'pending'"
                        groups="smart_inventory.group_smart_inventory_manager"/>
                <button name="action_si_reject" type="object" string="Reject Restock"
                        invisible="si_approval_state != 'pending'"
                        groups="smart_inventory.group_smart_inventory_manager"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="alert" invisible="si_approval_state != 'pending'">
                    This smart restock order is above the approval amount and waits for a Smart Inventory Manager.
                </div>
                <div class="alert alert-danger mb-0" role="alert" invisible="si_approval_state != 'rejected'">
                    Rejected: <field name="si_reject_reason" class="d-inline"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="si_is_smart_restock" invisible="1"/>
                <field name="si_approval_state" widget="badge" invisible="not si_is_smart_restock"
                       decoration-warning="si_approval_state == 'pending'"
                       decoration-success="si_approval_state == 'approved'"
                       decoration-danger="si_approval_state == 'rejected'"/>
                <field name="si_approved_by_id" invisible="not si_approved_by_id"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_search_smart" model="ir.ui.view">
        <field name="name">purchase.order.search.smart.inventory</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter string="Smart Restock" name="si_smart" domain="[('si_is_smart_restock', '=', True)]"/>
                <filter string="Waiting Restock Approval" name="si_pending"
                        domain="[('si_approval_state', '=', 'pending')]"/>
            </xpath>
        </field>
    </record>

    <record id="action_smart_purchase_orders" model="ir.actions.act_window">
        <field name="name">Smart Restock Orders</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_si_smart': 1}</field>
    </record>

    <record id="view_po_reject_wizard_form" model="ir.ui.view">
        <field name="name">smart.inventory.po.reject.wizard.form</field>
        <field name="model">smart.inventory.po.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Restock">
                <field name="order_ids" invisible="1"/>
                <group>
                    <field name="reason" placeholder="Why is this restock rejected?"/>
                </group>
                <footer>
                    <button name="action_reject" type="object" string="Reject" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
