<odoo>
    <record id="res_config_settings_view_form_smart_inventory" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.smart.inventory</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="60"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Smart Inventory" string="Smart Inventory" name="smart_inventory"
                     groups="smart_inventory.group_smart_inventory_manager">
                    <block title="Sales Automation" name="si_sales">
                        <setting company_dependent="1" help="Refuse to confirm a sale when a storable product lacks usable stock in the order's warehouse">
                            <field name="si_block_out_of_stock"/>
                        </setting>
                        <setting company_dependent="1" help="Validate the delivery right after confirmation">
                            <field name="si_auto_deliver"/>
                            <div class="mt-2" invisible="not si_auto_deliver">
                                <field name="si_create_backorder"/>
                                <label for="si_create_backorder"/>
                            </div>
                        </setting>
                        <setting company_dependent="1" help="Create and post the customer invoice after confirmation">
                            <field name="si_auto_invoice"/>
                        </setting>
                    </block>
                    <block title="Forecasting" name="si_forecast">
                        <setting help="Days of demand predicted by each forecast">
                            <field name="si_forecast_horizon"/>
                        </setting>
                        <setting help="Let Claude adjust the statistical forecast and explain the risk; otherwise the baseline is used">
                            <field name="si_ai_enabled"/>
                            <div class="mt-2" invisible="not si_ai_enabled">
                                <div class="alert alert-warning py-1 mb-2" role="alert" invisible="not si_ai_package_missing">
                                    Install the <code>anthropic</code> Python package on the server to use AI. Until then the baseline is used.
                                </div>
                                <field name="si_ai_package_missing" invisible="1"/>
                                <div groups="base.group_system"><label for="si_ai_api_key"/> <field name="si_ai_api_key" password="True" class="oe_inline"/></div>
                                <div><label for="si_ai_model"/> <field name="si_ai_model" class="oe_inline"/></div>
                                <div><label for="si_ai_max_adjust_pct"/> <field name="si_ai_max_adjust_pct" class="oe_inline"/></div>
                                <div><label for="si_ai_batch_size"/> <field name="si_ai_batch_size" class="oe_inline"/></div>
                                <div><label for="si_ai_daily_limit"/> <field name="si_ai_daily_limit" class="oe_inline"/></div>
                            </div>
                        </setting>
                    </block>
                    <block title="Replenishment" name="si_replenishment">
                        <setting help="Create purchase orders, or only maintain Odoo reordering rules">
                            <field name="si_replenish_mode"/>
                        </setting>
                        <setting help="Order enough stock for this many days of demand (computed reorder mode)">
                            <field name="si_target_cover_days"/>
                        </setting>
                        <setting help="Computed reorder mode: days of cover, or at least the economic order quantity">
                            <field name="si_order_qty_mode"/>
                            <div class="mt-2" invisible="si_order_qty_mode != 'eoq'">
                                <div><label for="si_order_cost"/> <field name="si_order_cost" class="oe_inline"/></div>
                                <div><label for="si_holding_cost_pct"/> <field name="si_holding_cost_pct" class="oe_inline"/></div>
                            </div>
                        </setting>
                        <setting help="Probability of not running out during the vendor lead time">
                            <field name="si_service_level"/>
                            <div class="mt-2">
                                <div><label for="si_service_level_a"/> <field name="si_service_level_a" class="oe_inline"/></div>
                                <div><label for="si_service_level_b"/> <field name="si_service_level_b" class="oe_inline"/></div>
                                <div><label for="si_service_level_c"/> <field name="si_service_level_c" class="oe_inline"/></div>
                            </div>
                        </setting>
                        <setting help="Smart restock POs above this amount need a manager's approval (0 = off)">
                            <field name="si_po_approval_amount"/>
                        </setting>
                    </block>
                    <block title="Stock Health and Alerts" name="si_health">
                        <setting help="Products with stock but no sale for this many days are dead stock and are not restocked">
                            <field name="si_dead_stock_days"/>
                        </setting>
                        <setting help="Show lots that expire within this many days on the dashboard">
                            <field name="si_expiry_alert_days"/>
                        </setting>
                        <setting company_dependent="1" help="Users who receive the daily risk digest (default: Smart Inventory Managers)">
                            <field name="si_digest_user_ids" widget="many2many_tags"/>
                        </setting>
                        <setting help="Products with more days of cover than this are overstock (cash tied up)">
                            <field name="si_overstock_days"/>
                        </setting>
                        <setting string="Chat Alerts" help="Send new high-risk products and the daily summary to Telegram, or to a WhatsApp or SMS gateway through a webhook">
                            <div class="mt-2">
                                <div groups="base.group_system"><label for="si_telegram_token"/> <field name="si_telegram_token" password="True" class="oe_inline"/></div>
                                <div><label for="si_telegram_chat_id"/> <field name="si_telegram_chat_id" class="oe_inline"/></div>
                                <div groups="base.group_system"><label for="si_alert_webhook_url"/> <field name="si_alert_webhook_url" class="oe_inline" placeholder="https://..."/></div>
                                <button name="action_si_test_alert" type="object" string="Send Test Alert" icon="fa-paper-plane" class="btn-link"/>
                            </div>
                        </setting>
                    </block>
                    <block title="Purchasing Control" name="si_purchasing">
                        <setting help="Restock needs wait in Replenishment, Suggestions to Review, for a manager to approve, edit or reject">
                            <field name="si_restock_review"/>
                        </setting>
                        <setting help="Smart restock orders per week (untaxed, company currency). Highest risks are ordered first; the rest become suggestions. 0 = no budget">
                            <field name="si_weekly_budget"/>
                        </setting>
                    </block>
                    <block title="Stock Counting" name="si_counting">
                        <setting help="Schedule counts by ABC class in Products, Cycle Count">
                            <field name="si_cycle_count"/>
                            <div class="mt-2" invisible="not si_cycle_count">
                                <div><label for="si_cycle_days_a"/> <field name="si_cycle_days_a" class="oe_inline"/></div>
                                <div><label for="si_cycle_days_b"/> <field name="si_cycle_days_b" class="oe_inline"/></div>
                                <div><label for="si_cycle_days_c"/> <field name="si_cycle_days_c" class="oe_inline"/></div>
                            </div>
                        </setting>
                        <setting help="Counts that change the quantity need a reason: damaged, expired, theft...">
                            <field name="si_require_adjust_reason"/>
                        </setting>
                        <setting help="Pick the lots that expire first (products with expiration dates, needs Product Expiry)">
                            <field name="si_fefo"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_smart_inventory_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'smart_inventory', 'bin_size': False}</field>
    </record>
</odoo>
