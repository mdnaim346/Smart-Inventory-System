<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_smart_inventory" model="res.groups.privilege">
        <field name="name">Smart Inventory</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <record id="group_smart_inventory_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_smart_inventory"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_smart_inventory_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_smart_inventory"/>
        <field name="implied_ids" eval="[(4, ref('group_smart_inventory_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_forecast_company" model="ir.rule">
        <field name="name">Smart Inventory Forecast: multi-company</field>
        <field name="model_id" ref="model_smart_inventory_forecast"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_stock_level_company" model="ir.rule">
        <field name="name">Smart Inventory Stock Level: multi-company</field>
        <field name="model_id" ref="model_smart_inventory_stock_level"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_transfer_suggestion_company" model="ir.rule">
        <field name="name">Smart Inventory Transfer Suggestion: multi-company</field>
        <field name="model_id" ref="model_smart_inventory_transfer_suggestion"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
